            <column-instance column='[Calculation_0060222823989254]' derivation='User' name='[usr:Calculation_0060222823989254:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <slices>
            <column>[federated.0ri82ka0fhtgyn11auxmz0an0i8s].[none:Country:nk]</column>
          </slices>
