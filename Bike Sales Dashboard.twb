            <column caption='Chosen Year Profit' datatype='integer' name='[Calculation_0060222822682628]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Date - Years] = [Parameters].[Parameter 0060222821445634] THEN [Profit] END' />
            </column>
            <column caption='Last Year Profit' datatype='integer' name='[Calculation_0060222823301125]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Date - Years] = DATEADD(&apos;year&apos;, -1, [Parameters].[Parameter 0060222821445634]) THEN [Profit] END' />
            </column>
            <column caption='YoY% Change' datatype='real' name='[Calculation_0060222823989254]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_0060222822682628]) - SUM([Calculation_0060222823301125]))/SUM([Calculation_0060222823301125])' />
            </column>
            <column caption='&quot;YoY% Change&quot;' datatype='string' name='[Calculation_0060222825164808]' role='dimension' type='nominal' user:unnamed='YoY% Change'>
              <calculation class='tableau' formula='&quot;YoY% Change&quot;' />
            </column>
